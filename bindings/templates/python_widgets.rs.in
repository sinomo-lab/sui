#[pymethods]
impl PyResponsiveSidebarState {
    #[new]
    #[pyo3(signature = (expanded=true, overlay_open=false))]
    pub fn new(expanded: bool, overlay_open: bool) -> Self {
        Self {
            inner: BindingResponsiveSidebarState::new(expanded, overlay_open),
        }
    }

    #[getter]
