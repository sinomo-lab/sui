fn extract_floating_views(views: &Bound<'_, PyAny>) -> PyResult<Vec<BindingFloatingView>> {
    Ok(views
        .extract::<Vec<PyRef<'_, PyFloatingView>>>()?
        .iter()
        .map(|view| view.inner.clone())
        .collect())
}

#[pyclass(name = "DockNode", module = "sui", skip_from_py_object)]
