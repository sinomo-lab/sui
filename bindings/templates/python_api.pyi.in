        color: Color | None = ...,
        font_size: float | None = ...,
        line_height: float | None = ...,
        font: FontHandle | None = ...,
        weight: int | None = ...,
        style: FontStyle | None = ...,
        stretch: FontStretch | None = ...,
    ) -> None: ...
    def draw_shader_rect(self, rect: Rect, shader: Shader) -> None: ...
