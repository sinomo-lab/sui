from __future__ import annotations

import os
from collections.abc import Callable, Mapping, Sequence
from typing import Literal, final

from typing_extensions import Self

from ._types import (
    Axis,
    BindingValue,
    FontStretch,
    FontStyle,
    IconGlyph,
    ImageFit,
    ScrollAxes,
    SemanticTone,
    SurfaceBorder,
    SurfaceElevation,
    SurfaceRole,
)

__version__: str


@final
class Point:
    def __new__(cls, x: float, y: float) -> Self: ...
    @property
    def x(self) -> float: ...
    @property
    def y(self) -> float: ...


@final
class Modifiers:
    def __new__(
        cls,
        shift: bool = ...,
        control: bool = ...,
        alt: bool = ...,
        meta: bool = ...,
    ) -> Self: ...
    @property
    def shift(self) -> bool: ...
    @property
    def control(self) -> bool: ...
    @property
    def alt(self) -> bool: ...
    @property
    def meta(self) -> bool: ...


@final
class Event:
    @staticmethod
    def pointer(
        kind: str,
        position: Point,
        pointer_id: int = ...,
        delta: Point | None = ...,
        button: str | None = ...,
        buttons: int = ...,
        modifiers: Modifiers | None = ...,
        pointer_kind: str = ...,
        is_primary: bool = ...,
    ) -> Event: ...
    @staticmethod
    def raw_mouse_motion(delta: Point, modifiers: Modifiers | None = ...) -> Event: ...
    @staticmethod
    def scroll(
        position: Point,
        delta: Point,
        mode: str = ...,
        pointer_id: int = ...,
        modifiers: Modifiers | None = ...,
    ) -> Event: ...
    @staticmethod
    def keyboard(
        key: str,
        state: str = ...,
        code: str | None = ...,
        text: str | None = ...,
        modifiers: Modifiers | None = ...,
        repeat: bool = ...,
        is_composing: bool = ...,
    ) -> Event: ...
    @staticmethod
    def ime(
        kind: str,
        text: str | None = ...,
        cursor_start: int | None = ...,
        cursor_end: int | None = ...,
    ) -> Event: ...
    @staticmethod
    def window(
        kind: str,
        value: bool | None = ...,
        size: Size | None = ...,
        scale_factor: float | None = ...,
        raw_dpi: float | None = ...,
        suggested_size: Size | None = ...,
        position: Point | None = ...,
    ) -> Event: ...
    @staticmethod
    def custom(kind: str, payload: str | None = ...) -> Event: ...
    @property
    def kind(self) -> str: ...
    @property
    def action(self) -> str | None: ...
    @property
    def pointer_id(self) -> int | None: ...
    @property
    def position(self) -> Point | None: ...
    @property
    def delta(self) -> Point | None: ...
    @property
    def scroll_mode(self) -> Literal["pixels", "lines"] | None: ...
    @property
    def button(self) -> str | None: ...
    @property
    def buttons(self) -> int | None: ...
    @property
    def modifiers(self) -> Modifiers | None: ...
    @property
    def device_kind(self) -> str | None: ...
    @property
    def is_primary(self) -> bool | None: ...
    @property
    def key(self) -> str | None: ...
    @property
    def code(self) -> str | None: ...
    @property
    def text(self) -> str | None: ...
    @property
    def state(self) -> str | None: ...
    @property
    def repeat(self) -> bool | None: ...
    @property
    def is_composing(self) -> bool | None: ...
    @property
    def custom_kind(self) -> str | None: ...
    @property
    def payload(self) -> str | None: ...
    @property
    def file_path(self) -> str | None: ...


@final
class EventContext:
