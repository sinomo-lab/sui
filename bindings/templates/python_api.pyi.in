from __future__ import annotations

from collections.abc import Callable, Mapping, Sequence
from typing import Any, Literal, Protocol, TypeAlias, TypedDict

BindingValue: TypeAlias = str | float | bool
Axis: TypeAlias = Literal["horizontal", "vertical"]
ScrollAxes: TypeAlias = Axis | Literal["both"]
SurfaceRole: TypeAlias = str
SurfaceBorder: TypeAlias = str
SurfaceElevation: TypeAlias = str
SemanticTone: TypeAlias = str
IconGlyph: TypeAlias = str
ImageFit: TypeAlias = str
FontStyle: TypeAlias = str
FontStretch: TypeAlias = str


class RichAttachmentOptions(TypedDict, total=False):
    media_type: str
    source: str
    size_bytes: int
    description: str


class RichExtensionOptions(TypedDict, total=False):
    summary: str
    body: str
    status: str
    initially_expanded: bool
    metadata: Mapping[str, str]


class Point:
    def __init__(self, x: float, y: float) -> None: ...
    x: float
    y: float


class Modifiers:
    def __init__(
        self,
        shift: bool = ...,
        control: bool = ...,
        alt: bool = ...,
        meta: bool = ...,
    ) -> None: ...
    shift: bool
    control: bool
    alt: bool
    meta: bool


class Event:
    @staticmethod
    def pointer(kind: str, position: Point, **options: Any) -> Event: ...
    @staticmethod
    def raw_mouse_motion(delta: Point, modifiers: Modifiers | None = ...) -> Event: ...
    @staticmethod
    def scroll(position: Point, delta: Point, **options: Any) -> Event: ...
    @staticmethod
    def keyboard(key: str, **options: Any) -> Event: ...
    @staticmethod
    def ime(kind: str, **options: Any) -> Event: ...
    @staticmethod
    def window(kind: str, **options: Any) -> Event: ...
    @staticmethod
    def custom(kind: str, payload: str | None = ...) -> Event: ...
    @property
    def kind(self) -> str: ...
    @property
    def action(self) -> str | None: ...
    @property
    def position(self) -> Point | None: ...
    @property
    def delta(self) -> Point | None: ...
    @property
    def text(self) -> str | None: ...


class EventContext:
    @property
    def window_id(self) -> int: ...
    @property
    def widget_id(self) -> int: ...
    @property
    def bounds(self) -> Rect: ...
    @property
    def current_time(self) -> float: ...
    @property
    def phase(self) -> Literal["capture", "target", "bubble"]: ...
    @property
    def focused(self) -> bool: ...
    @property
    def clipboard_text(self) -> str | None: ...
    def set_handled(self) -> None: ...
    def request_focus(self) -> None: ...
    def clear_focus(self) -> None: ...
    def request_measure(self) -> None: ...
    def request_arrange(self) -> None: ...
    def request_paint(self, rect: Rect | None = ...) -> None: ...
    def request_semantics(self) -> None: ...
    def request_animation_frame(self) -> None: ...
    def capture_pointer(self, pointer_id: int) -> None: ...
    def release_pointer(self, pointer_id: int) -> None: ...
    def set_clipboard_text(self, text: str) -> None: ...


class Size:
    def __init__(self, width: float, height: float) -> None: ...
    width: float
    height: float


class Rect:
    def __init__(self, x: float, y: float, width: float, height: float) -> None: ...
    x: float
    y: float
    width: float
    height: float
    @property
    def origin(self) -> Point: ...
    @property
    def size(self) -> Size: ...


class Path:
    @staticmethod
    def rect(rect: Rect) -> Path: ...
    @staticmethod
    def circle(center: Point, radius: float) -> Path: ...
    @staticmethod
    def rounded_rect(rect: Rect, radius: float) -> Path: ...
    @staticmethod
    def arc(center: Point, radius: float, start_angle: float, sweep_angle: float) -> Path: ...


class PathBuilder:
    def __init__(self) -> None: ...
    def move_to(self, point: Point) -> None: ...
    def line_to(self, point: Point) -> None: ...
    def quad_to(self, control: Point, target: Point) -> None: ...
    def cubic_to(self, first: Point, second: Point, target: Point) -> None: ...
    def close(self) -> None: ...
    def build(self) -> Path: ...


class Transform:
    @staticmethod
    def identity() -> Transform: ...
    @staticmethod
    def translation(x: float, y: float) -> Transform: ...
    @staticmethod
    def scale(x: float, y: float) -> Transform: ...
    @staticmethod
    def rotation(radians: float) -> Transform: ...


class Color:
    def __init__(self, red: float, green: float, blue: float, alpha: float = ...) -> None: ...
    @staticmethod
    def rgba(red: float, green: float, blue: float, alpha: float = ...) -> Color: ...
    red: float
    green: float
    blue: float
    alpha: float


class AnimationValue:
    @staticmethod
    def scalar(value: float) -> AnimationValue: ...
    @staticmethod
    def point(value: Point) -> AnimationValue: ...
    @staticmethod
    def vector(value: Point) -> AnimationValue: ...
    @staticmethod
    def size(value: Size) -> AnimationValue: ...
    @staticmethod
    def rect(value: Rect) -> AnimationValue: ...
    @staticmethod
    def color(value: Color) -> AnimationValue: ...
    @staticmethod
    def transform(value: Transform) -> AnimationValue: ...
    kind: Literal["scalar", "point", "vector", "size", "rect", "color", "transform"]
    scalar_value: float | None
    point_value: Point | None
    vector_value: Point | None
    size_value: Size | None
    rect_value: Rect | None
    color_value: Color | None
    transform_value: Transform | None


class Transition:
    def __init__(
        self,
        start: AnimationValue,
        end: AnimationValue,
        duration: float,
        *,
        start_time: float = ...,
        easing: str = ...,
    ) -> None: ...
    def progress(self, time: float) -> float: ...
    def sample(self, time: float) -> AnimationValue: ...
    def is_complete(self, time: float) -> bool: ...


class Spring:
    def __init__(
        self,
        value: float,
        *,
        stiffness: float = ...,
        damping: float = ...,
    ) -> None: ...
    def step(self, target: float, delta_seconds: float) -> float: ...
    value: float
    velocity: float
    stiffness: float
    damping: float


class AnimatedValue:
    def __init__(
        self,
        initial: AnimationValue,
        *,
        duration: float = ...,
        easing: str = ...,
    ) -> None: ...
    def set_duration(self, seconds: float) -> None: ...
    def set_easing(self, easing: str) -> None: ...
    def set_target(self, target: AnimationValue) -> None: ...
    def jump_to(self, value: AnimationValue) -> None: ...
    def tick(self, delta_seconds: float) -> bool: ...
    value: AnimationValue
    target: AnimationValue
    is_animating: bool


class Keyframe:
    def __init__(
        self,
        time: float,
        value: AnimationValue,
        *,
        easing: str = ...,
    ) -> None: ...
    time: float
    value: AnimationValue


class AnimationTrack:
    def __init__(self, target: str, property: str) -> None: ...
    def add_keyframe(self, keyframe: Keyframe) -> None: ...
    def set_enabled(self, enabled: bool) -> None: ...
    def sample(self, time: float) -> AnimationValue | None: ...
    target: str
    property: str
    keyframe_count: int


class AnimationClip:
    def __init__(self, id: str, start_time: float, duration: float) -> None: ...
    def add_track(self, track: AnimationTrack) -> None: ...
    def set_enabled(self, enabled: bool) -> None: ...
    id: str
    start_time: float
    duration: float
    track_count: int


class AnimationSample:
    clip_id: str
    target: str
    property: str
    time: float
    value: AnimationValue


class AnimationTimeline:
    def __init__(self, duration: float) -> None: ...
    def add_clip(self, clip: AnimationClip) -> None: ...
    def sample(self, time: float) -> list[AnimationSample]: ...
    duration: float
    clip_count: int


class AnimationPlayer:
    def __init__(self, timeline: AnimationTimeline) -> None: ...
    def play(self) -> None: ...
    def pause(self) -> None: ...
    def stop(self) -> None: ...
    def seek(self, time: float) -> None: ...
    def set_repeat(self, repeat: bool) -> None: ...
    def set_playback_rate(self, rate: float) -> None: ...
    def sample(self) -> list[AnimationSample]: ...
    def tick(self, delta_seconds: float) -> list[AnimationSample]: ...
    playhead: float
    is_playing: bool


class AnimationDocument:
    def __init__(self, name: str, timeline: AnimationTimeline) -> None: ...
    @staticmethod
    def parse(input: str) -> AnimationDocument: ...
    name: str
    timeline: AnimationTimeline
    def to_document_format(self) -> str: ...


class AnimationEditor:
    def __init__(self, document: AnimationDocument) -> None: ...
    document: AnimationDocument
    def set_playhead(self, time: float) -> None: ...
    def set_zoom(self, zoom: float) -> None: ...
    def set_scroll(self, scroll: float) -> None: ...
    def set_snapping(self, enabled: bool = ..., interval: float = ...) -> None: ...
    def add_keyframe(self, clip_index: int, track_index: int, keyframe: Keyframe) -> bool: ...
    def update_keyframe_easing(
        self,
        clip_index: int,
        track_index: int,
        keyframe_index: int,
        *,
        easing: str,
    ) -> bool: ...
    def remove_keyframe(self, clip_index: int, track_index: int, keyframe_index: int) -> bool: ...
    def undo(self) -> bool: ...
    def redo(self) -> bool: ...
    can_undo: bool
    can_redo: bool
    playhead: float
    zoom: float
    scroll: float


class Shadow:
    def __init__(
        self,
        offset_x: float,
        offset_y: float,
        blur: float,
        spread: float,
        color: Color,
    ) -> None: ...


class Constraints:
    @property
    def min(self) -> Size: ...
    @property
    def max(self) -> Size: ...
    def clamp(self, size: Size) -> Size: ...
    def loosen(self) -> Constraints: ...


class Paint:
    @property
    def bounds(self) -> Rect: ...
    @property
    def command_count(self) -> int: ...
    def clear(self, color: Color) -> None: ...
    def fill_rect(self, rect: Rect, color: Color) -> None: ...
    def stroke_rect(self, rect: Rect, color: Color, width: float = ...) -> None: ...
    def fill_path(self, path: Path, color: Color) -> None: ...
    def stroke_path(self, path: Path, color: Color, width: float = ...) -> None: ...
    def fill_rounded_rect(self, rect: Rect, color: Color, radii: Any = ...) -> None: ...
    def draw_text(self, rect: Rect, text: str, **style: Any) -> None: ...
    def draw_image(self, rect: Rect, image: ImageHandle) -> None: ...
    def push_clip_rect(self, rect: Rect) -> None: ...
    def push_clip_path(self, path: Path) -> None: ...
    def pop_clip(self) -> None: ...
    def push_transform(self, transform: Transform) -> None: ...
    def pop_transform(self) -> None: ...


class Semantics:
    @property
    def bounds(self) -> Rect: ...
    @property
    def focused(self) -> bool: ...
    @property
    def child_count(self) -> int: ...
    def node(self, **properties: Any) -> None: ...
    def child(self, index: int) -> bool: ...


class FontHandle: ...
class ImageHandle: ...
class Shader: ...


class WidgetCallbacks(Protocol):
    name: str
    def measure(self, constraints: Constraints) -> Size: ...
    def measure_with_children(self, constraints: Constraints, child_sizes: Sequence[Size]) -> Size: ...
    def arrange(self, bounds: Rect, child_sizes: Sequence[Size]) -> Sequence[Rect]: ...
    def event(self, event: Event) -> bool | None: ...
    def event_with_context(self, event: Event, context: EventContext) -> bool | None: ...
    def paint(self, paint: Paint) -> None: ...
    def semantics(self, semantics: Semantics) -> None: ...


class Widget:
    def __init__(
        self,
        callbacks: WidgetCallbacks,
        children: Sequence[Widget] | None = ...,
    ) -> None: ...


class State:
    def __init__(self, value: BindingValue) -> None: ...
    def get(self) -> BindingValue: ...
    def set(self, value: BindingValue) -> None: ...
    def select(self, selector: Callable[[BindingValue], BindingValue]) -> State: ...
    def watch(self, callback: Callable[[BindingValue], None]) -> StateSubscription: ...


class StateSubscription:
    def unsubscribe(self) -> bool: ...


class NotificationCenter:
    def __init__(self) -> None: ...
    def notify(
        self,
        title: str,
        message: str,
        duration: float | None = ...,
        urgency: Literal["polite", "assertive"] = ...,
    ) -> int: ...
    def dismiss(self, id: int) -> bool: ...
    def clear(self) -> bool: ...
    @property
    def size(self) -> int: ...


class VirtualListItem:
    def __init__(self, key: int, text: str) -> None: ...
    @property
    def key(self) -> int: ...
    @property
    def text(self) -> str: ...


class VirtualListModel:
    def __init__(
        self,
        name: str,
        items: Sequence[VirtualListItem] | None = ...,
    ) -> None: ...
    @property
    def size(self) -> int: ...
    def append(self, item: VirtualListItem) -> bool: ...
    def prepend(self, items: Sequence[VirtualListItem]) -> bool: ...
    def update(self, item: VirtualListItem) -> bool: ...
    def remove(self, key: int) -> bool: ...
    def move_to(self, key: int, index: int) -> bool: ...
    def replace(self, items: Sequence[VirtualListItem]) -> bool: ...


class FloatingView:
    def __init__(
        self,
        title: str,
        bounds: Rect,
        child: Widget,
        min_size: Size | None = ...,
        visible: bool = ...,
    ) -> None: ...


class FloatingViewSnapshot:
    id: int
    title: str
    bounds: Rect
    min_size: Size
    visible: bool
    maximized: bool


class FloatingWorkspaceState:
    def __init__(self) -> None: ...
    def views(self) -> list[FloatingViewSnapshot]: ...
    def set_visible(self, id: int, visible: bool) -> bool: ...
    def set_bounds(self, id: int, bounds: Rect) -> bool: ...
    def bring_to_front(self, id: int) -> bool: ...
    def set_maximized(self, id: int, maximized: bool) -> bool: ...


class PixelCanvasExport:
    revision: int
    name: str
    width: int
    height: int
    rgba8: bytes


class PixelCanvasState:
    def __init__(self) -> None: ...
    tool: Literal["brush", "eraser", "fill", "pan"]
    brush_color: Color
    brush_size: float
    brush_opacity: float
    brush_shape: Literal["square", "round"]
    blend_mode: Literal["normal", "multiply", "screen", "overlay"]
    editable: bool
    can_undo: bool
    can_redo: bool
    can_clear: bool
    def undo(self) -> None: ...
    def redo(self) -> None: ...
    def clear(self) -> None: ...
    def fit_view(self) -> None: ...
    def actual_size(self) -> None: ...
    def zoom_in(self) -> None: ...
    def zoom_out(self) -> None: ...
    def request_export(self) -> None: ...
    def latest_export(self) -> PixelCanvasExport | None: ...


class RichDocumentUpdate:
    @property
    def revision(self) -> int: ...
    @property
    def reparsed_start(self) -> int: ...
    @property
    def reparsed_end(self) -> int: ...
    @property
    def reused_prefix_blocks(self) -> int: ...
    @property
    def changed_block_ids(self) -> list[int]: ...
    @property
    def append_only(self) -> bool: ...


class RichDocument:
    def __init__(self, markdown: str = ...) -> None: ...
    @property
    def revision(self) -> int: ...
    @property
    def markdown(self) -> str: ...
    def set_markdown(self, markdown: str) -> bool: ...
    def append_markdown(self, fragment: str) -> bool: ...
    def last_update(self) -> RichDocumentUpdate: ...
    def append_attachment(
        self,
        name: str,
        *,
        media_type: str | None = ...,
        source: str | None = ...,
        size_bytes: int | None = ...,
        description: str | None = ...,
    ) -> int: ...
    def append_extension(
        self,
        renderer: str,
        title: str,
        *,
        summary: str | None = ...,
        body: str = ...,
        status: str = ...,
        initially_expanded: bool = ...,
        metadata: Mapping[str, str] | None = ...,
    ) -> int: ...


class DockNode:
    @staticmethod
    def empty() -> DockNode: ...
    @staticmethod
    def tabs(panel_ids: Sequence[int], active: int | None = ...) -> DockNode: ...
    @staticmethod
    def split(axis: Axis, fraction: float, first: DockNode, second: DockNode) -> DockNode: ...


class DockFloatingGroup:
    def __init__(
        self,
        id: int,
        panel_ids: Sequence[int],
        active: int,
        bounds: Rect,
    ) -> None: ...
    @property
    def id(self) -> int: ...
    @property
    def panel_ids(self) -> list[int]: ...
    @property
    def active(self) -> int: ...
    @property
    def bounds(self) -> Rect: ...


class DockLayout:
    def __init__(
        self,
        root: DockNode,
        floating: Sequence[DockFloatingGroup] | None = ...,
        hidden: Sequence[int] | None = ...,
    ) -> None: ...
    @property
    def root(self) -> DockNode: ...
    @property
    def floating(self) -> list[DockFloatingGroup]: ...
    @property
    def hidden(self) -> list[int]: ...


class DockState:
    def __init__(self, layout: DockLayout | None = ...) -> None: ...
    def snapshot(self) -> DockLayout: ...
    def apply(self, layout: DockLayout) -> bool: ...
    def dock(self, panel: int, target: int, zone: str = ...) -> bool: ...
    def dock_to_root(self, panel: int, zone: str = ...) -> bool: ...
    def float_panel(self, panel: int, bounds: Rect) -> int: ...
    def hide(self, panel: int) -> bool: ...
    def show(self, panel: int) -> bool: ...
    def activate(self, panel: int) -> bool: ...


class DockPanelSpec:
    def __init__(self, id: int, title: str, child: Widget) -> None: ...
    @property
    def id(self) -> int: ...
    @property
    def title(self) -> str: ...


class Theme:
    def __init__(
        self,
        preset: str = ...,
        *,
        accent: Color | None = ...,
        control_size: str | None = ...,
    ) -> None: ...
    @staticmethod
    def light() -> Theme: ...
    @staticmethod
    def dark() -> Theme: ...
    @staticmethod
    def neutral() -> Theme: ...
    @staticmethod
    def neutral_dark() -> Theme: ...
    @staticmethod
    def high_contrast() -> Theme: ...
    @staticmethod
    def oled() -> Theme: ...
    def set_preset(self, preset: str) -> None: ...
    def set_accent(self, color: Color) -> None: ...
    def set_control_size(self, size: str) -> None: ...
    def color(self, name: str) -> Color: ...
    def set_color(self, name: str, color: Color) -> None: ...
    def number(self, name: str) -> float: ...
    def set_number(self, name: str, value: float) -> None: ...
    @property
    def accent(self) -> Color: ...


class RenderOptions:
    def __init__(self, **options: Any) -> None: ...
    @staticmethod
    def hdr() -> RenderOptions: ...
    @staticmethod
    def wide_gamut() -> RenderOptions: ...


class Window:
    def __init__(self, title: str, **options: Any) -> None: ...
    def root(self, widget: Widget) -> Window: ...


class App:
    def __init__(
        self,
        *,
        theme: Theme | None = ...,
        render_options: RenderOptions | None = ...,
    ) -> None: ...
    def window(self, window: Window) -> None: ...
    def set_theme(self, theme: Theme) -> None: ...
    def configure_rendering(self, options: RenderOptions) -> None: ...
    def on(self, name: str, callback: Callable[[BindingValue], None]) -> None: ...
    def render(self, index: int = ...) -> RenderSnapshot: ...
    def start(self) -> RunningApp: ...
    def run(self) -> None: ...


class WindowHandle:
    @property
    def id(self) -> int: ...


class UiHandle:
    def post(self, callback: Callable[[], None]) -> None: ...
    def emit(self, name: str, payload: BindingValue) -> bool: ...
    def pending_count(self) -> int: ...


class RunningApp:
    def ui_handle(self) -> UiHandle: ...
    def drain(self) -> int: ...
    def tick(self, frame_time: float) -> None: ...
    def drain_ready_events(self) -> int: ...
    def request_redraw_all(self) -> None: ...
    def wake_window(self, window: WindowHandle) -> None: ...
    def handle_event_for(self, window: WindowHandle, event: Event) -> None: ...
    def set_render_options(self, window: WindowHandle, options: RenderOptions) -> None: ...
    def set_inspector_tracing(self, enabled: bool = ..., index: int = ...) -> None: ...
    def inspect(self, index: int = ...) -> InspectorSnapshot: ...
    def render(self, index: int = ...) -> RenderSnapshot: ...
    def render_window(self, window: WindowHandle) -> RenderSnapshot: ...
    def handle_event(self, event: Event, index: int = ...) -> None: ...
    def hover(self, node: SemanticNode, index: int = ...) -> None: ...
    def click(self, node: SemanticNode, index: int = ...) -> None: ...
    def press(self, node: SemanticNode, key: str, index: int = ...) -> None: ...
    def fill(self, node: SemanticNode, text: str, index: int = ...) -> None: ...


class FrameTiming:
    phase: str
    duration_ms: float


class WidgetTiming:
    widget_id: int
    widget_name: str
    phase: str
    duration_ms: float
    calls: int


class EventRouteTrace:
    sequence: int
    event_kind: str
    target_id: int
    path: list[int]
    handled: bool


class ReactiveInvalidationTrace:
    widget_id: int
    source_name: str
    version: int
    kind: str
    delivered: bool


class CommandDispatchTrace:
    sequence: int
    name: str
    payload_type: str
    target: str
    delivery: str
    handlers: list[str]
    handled: bool
    delivered: bool


class InvalidationTrace:
    target: str
    kind: str
    source: str
    reason: str | None


class WidgetRebuildTrace:
    widget_id: int
    widget_name: str
    reason: str


class InspectorSnapshot:
    window_id: int
    title: str
    tracing_enabled: bool
    focused_widget_id: int | None
    window_focused: bool
    scheduled_phases: list[str]
    semantics_count: int
    semantics_nodes: list[SemanticNode]
    widget_count: int
    stack_host_count: int
    overlay_count: int
    timer_count: int
    async_task_count: int
    requested_animation_frame_count: int
    widget_diagnostics_count: int
    event_route_count: int
    reactive_invalidation_count: int
    command_dispatch_count: int
    invalidation_count: int
    widget_rebuild_count: int
    frame_timings: list[FrameTiming]
    widget_timings: list[WidgetTiming]
    event_routes: list[EventRouteTrace]
    reactive_invalidations: list[ReactiveInvalidationTrace]
    command_dispatches: list[CommandDispatchTrace]
    invalidations: list[InvalidationTrace]
    widget_rebuilds: list[WidgetRebuildTrace]


class ExternalTextureDescriptor: ...
class ExternalBackendHandle: ...
class ExternalSync: ...
class RendererInteropCapabilities: ...
class UiTaskQueue: ...


class SemanticNode:
    id: int
    parent_id: int | None
    role: str
    name: str | None
    value: str | None
    description: str | None
    bounds: Rect
    center: Point
    actions: list[str]
    checked: str | None
    busy: bool
    disabled: bool
    focused: bool
    hidden: bool
    hovered: bool
    selected: bool
    expanded: bool | None
    editable: bool
    multiline: bool
    visible: bool


class RenderSnapshot:
    command_count: int
    semantics_count: int
    semantics_nodes: list[SemanticNode]
    semantics_roles: list[str]
    semantics_names: list[str]
    semantics_values: list[str]
    semantics_descriptions: list[str]
    fill_rect_count: int
    draw_image_count: int
    def find(
        self,
        *,
        role: str | None = ...,
        name: str | None = ...,
        text: str | None = ...,
        description: str | None = ...,
        focused: bool | None = ...,
        visible: bool | None = ...,
    ) -> list[SemanticNode]: ...
    def get_one(
        self,
        *,
        role: str | None = ...,
        name: str | None = ...,
        text: str | None = ...,
    ) -> SemanticNode: ...


def render_widget(widget: Widget, event: Event | None = ...) -> RenderSnapshot: ...
