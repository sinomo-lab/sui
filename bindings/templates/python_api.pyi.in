        self, slot: int, width: int, height: int, pixels: bytes | Sequence[int]
    ) -> ImageHandle: ...
    def draw_image(self, rect: Rect, image: ImageHandle) -> None: ...
    def draw_image_quad(self, points: Sequence[Point], image: ImageHandle) -> None: ...
    def push_clip_rect(self, rect: Rect) -> None: ...
    def push_clip_path(self, path: Path) -> None: ...
    def pop_clip(self) -> None: ...
    def push_transform(self, transform: Transform) -> None: ...
    def pop_transform(self) -> None: ...


