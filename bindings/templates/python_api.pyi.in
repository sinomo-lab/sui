@final
class Transform:
    def __new__(
        cls, xx: float, yx: float, xy: float, yy: float, dx: float, dy: float
    ) -> Self: ...
    @staticmethod
    def identity() -> Transform: ...
    @staticmethod
    def translation(x: float, y: float) -> Transform: ...
    @staticmethod
    def scale(x: float, y: float) -> Transform: ...
    @staticmethod
    def rotation(radians: float) -> Transform: ...
    def then(self, next: Transform) -> Transform: ...
    @property
    def xx(self) -> float: ...
    @property
    def yx(self) -> float: ...
    @property
    def xy(self) -> float: ...
    @property
    def yy(self) -> float: ...
    @property
    def dx(self) -> float: ...
    @property
    def dy(self) -> float: ...


@final
class Color:
