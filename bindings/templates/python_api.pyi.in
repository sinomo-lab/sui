@final
class AnimationValue:
    @staticmethod
    def scalar(value: float) -> AnimationValue: ...
    @staticmethod
    def point(value: Point) -> AnimationValue: ...
    @staticmethod
    def vector(value: Point) -> AnimationValue: ...
    @staticmethod
    def size(value: Size) -> AnimationValue: ...
    @staticmethod
    def rect(value: Rect) -> AnimationValue: ...
    @staticmethod
    def color(value: Color) -> AnimationValue: ...
    @staticmethod
    def transform(value: Transform) -> AnimationValue: ...
    @property
    def kind(
        self,
    ) -> Literal["scalar", "point", "vector", "size", "rect", "color", "transform"]: ...
    @property
    def scalar_value(self) -> float | None: ...
    @property
    def point_value(self) -> Point | None: ...
    @property
    def vector_value(self) -> Point | None: ...
    @property
    def size_value(self) -> Size | None: ...
    @property
    def rect_value(self) -> Rect | None: ...
    @property
    def color_value(self) -> Color | None: ...
    @property
    def transform_value(self) -> Transform | None: ...


@final
class Transition:
